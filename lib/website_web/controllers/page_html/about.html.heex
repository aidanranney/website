<Layouts.app flash={@flash} current_scope={@current_scope}>
  <article class="space-y-6">
    <h1 class="text-3xl font-semibold tracking-tight">About</h1>
    <img src="/images/portrait.jpg" alt="portrait" class="border w-full max-w-xs" />
    <div class="space-y-4 text-lg leading-8 text-zinc-600">
      <p>
        I've worked in a variety of languages and frameworks. Highlights have been working in the Elixir and BEAM ecosystem, as well as Ruby on Rails and Flutter.
      </p>
      <p>
        When I'm not building for work or for fun, I'm usually on my bike.
      </p>
    </div>
  </article>
</Layouts.app>
