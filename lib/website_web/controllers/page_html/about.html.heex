<Layouts.app flash={@flash} current_scope={@current_scope}>
  <article class="space-y-6">
    <h1 class="text-3xl font-semibold tracking-tight">About</h1>
    <div class="space-y-4 text-lg leading-8 text-zinc-600">
      <p>
        I'm Aidan Ranney, a software developer. I care about clear interfaces, dependable systems,
        and the small details that make software pleasant to use.
      </p>
      <p>
        Most of my work is on the web: Elixir and Phoenix on the server, with a careful eye on the
        experience in the browser. When I'm not building, I'm usually reading or out for a run.
      </p>
    </div>
  </article>
</Layouts.app>
