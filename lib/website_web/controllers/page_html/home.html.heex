<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="space-y-6">
    <p class="text-xs font-medium tracking-[0.2em] text-zinc-500 uppercase">Software developer</p>
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Aidan Ranney</h1>
    <p class="text-lg leading-8 text-zinc-600">
      I'm a software developer with over 7 years of experience in the industry. I've worked as a contractor on my own
      and as a senior contributor on a team. It's my pleasure to work with others, who I can help mentor
      and also learn from, in a cross-functional collaraborative environment.
    </p>
    <div class="flex flex-wrap gap-x-6 gap-y-2 pt-2 text-sm font-medium">
      <.link
        navigate={~p"/about"}
        class="text-zinc-900 underline decoration-zinc-300 underline-offset-4 transition-colors hover:decoration-zinc-900"
      >
        About me
      </.link>
    </div>
  </section>
</Layouts.app>
