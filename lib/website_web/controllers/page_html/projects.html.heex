<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="space-y-8">
    <h1 class="text-3xl font-semibold tracking-tight">Projects</h1>
    <ul class="divide-y divide-zinc-200">
      <li class="py-6 first:pt-0">
        <h2 class="font-medium">This website</h2>
        <p class="mt-2 text-zinc-600">
          A personal site built with Phoenix LiveView and Tailwind CSS, with email-verified accounts.
        </p>
      </li>
      <li class="py-6">
        <h2 class="font-medium">Project name</h2>
        <p class="mt-2 text-zinc-600">
          A short description of the problem it solved and what you built.
        </p>
      </li>
      <li class="py-6 last:pb-0">
        <h2 class="font-medium">Project name</h2>
        <p class="mt-2 text-zinc-600">
          Another short description of the work and the result.
        </p>
      </li>
    </ul>
  </section>
</Layouts.app>
